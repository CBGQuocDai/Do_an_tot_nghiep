# Copy thành gitops/secrets.env (đã gitignore), điền giá trị rồi chạy: gitops/scripts/seal-secrets.sh
# Không bọc giá trị trong dấu nháy.

# Public key in ra từ: age-keygen -o age.agekey
AGE_PUBLIC_KEY=

# Harbor robot account (chỉ cần quyền pull) — dùng cho pod và cho Flux quét tag
HARBOR_USERNAME=
HARBOR_PASSWORD=

# Token HMAC của webhook Flux, dùng chung với GitHub secret FLUX_WEBHOOK_TOKEN.
# Để trống thì script tự sinh và ghi lại vào file này.
FLUX_WEBHOOK_TOKEN=

# Env và service account của backend (đường dẫn tương đối so với gốc repo hoặc tuyệt đối)
BACKEND_ENV_FILE=../DA/DA_Backend/.env
GCP_CREDENTIALS_FILE=../DA/DA_Backend/gcloud.json
